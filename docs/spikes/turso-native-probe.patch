+// Temporary size/startup spike. In-memory database only; removed after measurement.
+#[no_mangle]
+pub extern "C" fn reson_turso_spike() -> i32 {
+    guard(|| pollster::block_on(async {
+        let Ok(db) = turso::Builder::new_local(":memory:").build().await else { return 5; };
+        let Ok(conn) = db.connect() else { return 5; };
+        if conn.execute("CREATE TABLE probe(id INTEGER PRIMARY KEY, title TEXT)", ()).await.is_err() { return 5; }
+        let Ok(mut rows) = conn.query("SELECT COUNT(*) FROM probe", ()).await else { return 5; };
+        if rows.next().await.is_err() { return 5; }
+        0
+    }))
+}
