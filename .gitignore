# Rust build artifacts. Keep Cargo.lock tracked for reproducible app builds.
/target/

# Packaged apps, generated test tones and local build outputs.
/build/
/DerivedData/

# Swift Package Manager and Xcode user state.
macos/.build/
macos/.swiftpm/
**/xcuserdata/
*.xcuserstate
*.xcscmblueprint

# macOS filesystem metadata.
.DS_Store
.AppleDouble
._*

# Editor temporary files.
*~
*.swp
*.swo

# Local environment and signing secrets.
.env
.env.*
!.env.example
*.p12
*.pfx

# Local library databases and SQLite sidecars (may contain private music paths).
*.db
*.db-wal
*.db-shm

# Python test and tooling bytecode.
__pycache__/
*.py[cod]
